# Copy to .env and fill in your own keys (`.env` is git-ignored).
#   cp .env.example .env  &&  $EDITOR .env
# Real environment variables override .env. The whole offline/structural path
# (model, compare, report, tiddlers, folder, latex, …) needs NO keys; only
# `mathpix`, `snip`, `bibfetch`, and `vision` call out.

# MathPix — https://mathpix.com/ (Console -> API Keys); free tier available.
MATHPIX_APP_ID=your_app_id_here
MATHPIX_APP_KEY=your_app_key_here

# Perplexity — https://www.perplexity.ai/ (Settings -> API).
PERPLEXITY_API_KEY=your_perplexity_key_here

# OpenAI — https://platform.openai.com/api-keys. GPT-4o vision for
# `pdfdrill vision`: reads CDN crops MathPix left as images (incl. table cells)
# → math / TikZ / gnuplot / table.
OPENAI_API_KEY=your_openai_key_here

# DeepL — https://www.deepl.com/your-account/keys. `pdfdrill translate` renders
# prose tiddlers into another language. A free key ends in `:fx`.
DEEPL_API_KEY=your_deepl_key_here

# Novita — https://novita.ai/ (Settings -> Key Management). Gemma-4 vision OCR for
# `pdfdrill snip --gemma` and the `route` Gemma lane (scanned ≤20-page docs →
# LaTeX/tables). Override model/endpoint with GEMMA_MODEL / NOVITA_BASE_URL.
NOVITA_API_KEY=your_novita_key_here

# Makora — https://makora.com/ (inference.makora.com). The SAME Gemma-4 as
# Novita above, on the host measured cheapest and fastest (0.000718 EUR/page,
# 3-6 s/page): `pdfdrill gemmaocr` reads a whole scan with it.
#
# THE ACCOUNT IS A FIXED PREPAYMENT, not a subscription. When the balance
# empties the endpoint stops answering — mid-document, leaving a half-read
# document. So also set PDFDRILL_OCR_BUDGET_EUR to the balance you believe is
# left: `gemmaocr` estimates the read against it and REFUSES rather than start
# a read it cannot finish. `pdfdrill spend <pdf>` reads what a document has
# cost back out of the call log.
# Override model/endpoint with MAKORA_MODEL / MAKORA_BASE_URL.
MAKORA_API_KEY=your_makora_key
PDFDRILL_OCR_BUDGET_EUR=10.00
