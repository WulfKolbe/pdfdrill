+    @classmethod
+    def get_encoding_names(
+        cls,
+        name: str,
+        diff: Iterable[object] | None = None,
+        base: bool = True,
+    ) -> dict[int, str]:
+        """cid -> POSTSCRIPT GLYPH NAME, the twin of `get_encoding`.
+
+        `get_encoding` answers "what Unicode character is this?" and drops the
+        entry when there is no answer — which is why a `/star` or `/lscript`
+        from a TeX maths font arrives downstream as `(cid:7)`. The glyph NAME
+        is what the PDF actually states, it is always available where a
+        `/Differences` array or a base encoding is, and it is a strictly
+        stronger identifier than Unicode: `parenleftbigg` and `parenleftbig`
+        are one Unicode character but two different glyphs.
+
+        No name is ever dropped: unlike `get_encoding` this never calls
+        `name2unicode`, so an unmappable name is still reported.
+
+        Pass `base=False` for a SYMBOLIC font that states no base encoding.
+        Such a font carries its own built-in encoding, so only the
+        `/Differences` entries are stated by the PDF and the Latin tables say
+        nothing about the rest — returning their names would be an invention
+        rather than a reading.
+        """
+        cid2name = cls.name_encodings.get(name, cls.std2name) if base else {}
+        if diff:
+            cid2name = cid2name.copy()
+            cid = 0
+            for x in diff:
+                if isinstance(x, int):
+                    cid = x
+                elif isinstance(x, PSLiteral):
+                    cid2name[cid] = cast(str, x.name)
+                    cid += 1
+        return cid2name
