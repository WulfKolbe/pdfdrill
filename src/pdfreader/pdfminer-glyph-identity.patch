diff --git a/tests/test_glyphname.py b/tests/test_glyphname.py
new file mode 100644
index 0000000..38d60c8
--- /dev/null
+++ b/tests/test_glyphname.py
@@ -0,0 +1,291 @@
+"""Tests for PostScript glyph-name preservation (cid2name / to_glyphname /
+LTChar.glyphname).
+
+Each test names one guarantee. They are independent: none depends on another
+having run, and none shares fixture state.
+"""
+
+import pytest
+
+from tests.helpers import absolute_sample_path
+from pdfminer.encodingdb import EncodingDB
+from pdfminer.high_level import extract_pages
+from pdfminer.layout import LTChar
+from pdfminer.pdffont import PDFFont
+from pdfminer.psparser import PSLiteral
+
+# The /Encoding /Differences array of font F4 (…+MTMI) in a real MathTime
+# document, verbatim. `star` and `lscript` have no Unicode equivalent, which
+# is precisely why they used to arrive as "(cid:7)" / "(cid:4)".
+MTMI_DIFFERENCES = [2] + [
+    PSLiteral(n)
+    for n in (
+        "theta", "chi", "lscript", "theta1", "alpha", "star", "epsilon",
+        "Gamma", "beta", "gamma", "eta", "delta", "Sigma",
+    )
+]
+
+
+class TestGetEncodingNames:
+    def test_differences_yield_names(self):
+        """G: a name in /Differences is reported at its code."""
+        names = EncodingDB.get_encoding_names("StandardEncoding", MTMI_DIFFERENCES)
+        assert names[2] == "theta"
+        assert names[6] == "alpha"
+        assert names[7] == "star"
+
+    def test_unmappable_name_is_kept(self):
+        """G: a name with no Unicode equivalent is still reported.
+
+        This is the whole point: `get_encoding` drops these, so the identity
+        the PDF states is lost. `get_encoding_names` must not drop them.
+        """
+        names = EncodingDB.get_encoding_names("StandardEncoding", MTMI_DIFFERENCES)
+        unicodes = EncodingDB.get_encoding("StandardEncoding", MTMI_DIFFERENCES)
+        for cid, name in ((4, "lscript"), (7, "star")):
+            assert names[cid] == name
+            assert cid not in unicodes, "precondition: no Unicode for this glyph"
+
+    def test_base_encoding_without_differences(self):
+        """G: names are available from a base encoding alone."""
+        assert EncodingDB.get_encoding_names("WinAnsiEncoding")[65] == "A"
+        assert EncodingDB.get_encoding_names("StandardEncoding")[65] == "A"
+
+    def test_unknown_base_encoding_falls_back_to_standard(self):
+        """G: same fallback as get_encoding, so the two stay in step."""
+        assert EncodingDB.get_encoding_names("NoSuchEncoding")[65] == "A"
+
+    def test_does_not_mutate_the_shared_table(self):
+        """G: building a per-font map never edits the class-level table."""
+        before = dict(EncodingDB.std2name)
+        EncodingDB.get_encoding_names("StandardEncoding", MTMI_DIFFERENCES)
+        assert EncodingDB.std2name == before
+
+    def test_get_encoding_is_unchanged(self):
+        """G1: the existing Unicode path behaves exactly as before."""
+        u = EncodingDB.get_encoding("StandardEncoding", MTMI_DIFFERENCES)
+        assert u[6] == "\u03b1"      # alpha
+        assert u[5] == "\u03d1"      # theta1
+        assert 7 not in u            # star: still no Unicode, still absent
+
+
+class TestToGlyphname:
+    def test_default_is_none_not_an_exception(self):
+        """G3: absence is an ordinary answer, unlike to_unichr."""
+        font = PDFFont.__new__(PDFFont)      # no __init__: bare default
+        assert font.to_glyphname(7) is None
+
+    def test_default_table_is_write_protected(self):
+        """G: the empty class default cannot be mutated into shared state."""
+        with pytest.raises(TypeError):
+            PDFFont.cid2name[7] = "star"     # type: ignore[index]
+
+
+class TestLTCharGlyphname:
+    def _chars(self, name):
+        out = []
+
+        def walk(o):
+            if isinstance(o, LTChar):
+                out.append(o)
+            elif hasattr(o, "__iter__"):
+                for c in o:
+                    walk(c)
+
+        for layout in extract_pages(absolute_sample_path(name)):
+            for e in layout:
+                walk(e)
+        return out
+
+    def test_simple_font_chars_carry_names(self):
+        """G: a simple-font glyph reports its PostScript name."""
+        chars = self._chars("simple1.pdf")
+        assert chars, "precondition: the sample yields glyphs"
+        named = [c for c in chars if c.glyphname]
+        assert named, "no glyph reported a name"
+        for c in named:
+            assert isinstance(c.cid, int) and c.cid >= 0
+
+    def test_undefined_chars_still_have_identity(self):
+        """The claim, on a real file: text is (cid:N), identity is not lost."""
+        chars = self._chars("contrib/issue-1061-colour-space-stack.pdf")
+        undefined = [c for c in chars if c.get_text().startswith("(cid:")]
+        assert undefined, "precondition: this sample has unmapped glyphs"
+        recovered = [c for c in undefined if c.glyphname]
+        assert len(recovered) == len(undefined), (
+            f"{len(undefined) - len(recovered)} of {len(undefined)} "
+            "unmapped glyphs reported no name"
+        )
+
+    def test_cid_defaults_keep_direct_construction_working(self):
+        """G1: third-party code constructing LTChar without cid still works.
+
+        pdfminer advertises that any component can be replaced, so the new
+        parameter must be optional and must not make glyphname lie.
+        """
+
+        class _Font:
+            fontname = "Test"
+            cid2name: dict = {}
+
+            def is_vertical(self):
+                return False
+
+            def get_descent(self):
+                return 0.0
+
+            def to_glyphname(self, cid):
+                return None
+
+        ch = LTChar(
+            (1, 0, 0, 1, 0, 0), _Font(), 10.0, 1.0, 0.0, "x", 0.5, 0.0, None, None
+        )
+        assert ch.cid == -1
+        assert ch.glyphname is None
+
+
+class TestSymbolicFonts:
+    """A symbolic font supplies its own built-in encoding.
+
+    The Latin base encodings say nothing about its codes, so reporting one of
+    their names is an invention. Measured on a PowerPoint/Equation-Editor deck
+    where every maths glyph lives in a symbolic `Symbol` font with no
+    /Encoding at all: code 37 is a relation sign, and StandardEncoding would
+    call it `percent`. Abstaining is the only correct answer, and a wrong name
+    is worse than none because nothing downstream can tell it is wrong.
+    """
+
+    SYMBOLIC = {"Flags": 6}          # bit 3 set
+    NONSYMBOLIC = {"Flags": 32}      # bit 6 set
+
+    def _font(self, descriptor, spec):
+        from pdfminer.pdffont import PDFSimpleFont
+
+        return PDFSimpleFont(descriptor, {}, spec)
+
+    def test_symbolic_without_encoding_states_no_names(self):
+        font = self._font(self.SYMBOLIC, {})
+        assert font.cid2name == {}
+        assert font.to_glyphname(37) is None
+
+    def test_nonsymbolic_without_encoding_uses_base_encoding(self):
+        """G1-adjacent: the ordinary case must not regress."""
+        font = self._font(self.NONSYMBOLIC, {})
+        assert font.to_glyphname(65) == "A"
+
+    def test_symbolic_reports_its_differences_only(self):
+        """What the PDF states is kept; what it does not state stays unknown."""
+        spec = {"Encoding": {"Differences": [7, PSLiteral("star")]}}
+        font = self._font(self.SYMBOLIC, spec)
+        assert font.to_glyphname(7) == "star"
+        assert font.to_glyphname(65) is None, "base encoding must not leak in"
+
+    def test_symbolic_with_explicit_base_encoding_is_trusted(self):
+        """An explicit BaseEncoding is a statement by the PDF, so honour it."""
+        spec = {
+            "Encoding": {
+                "BaseEncoding": PSLiteral("WinAnsiEncoding"),
+                "Differences": [7, PSLiteral("star")],
+            }
+        }
+        font = self._font(self.SYMBOLIC, spec)
+        assert font.to_glyphname(7) == "star"
+        assert font.to_glyphname(65) == "A"
+
+    def test_symbolic_with_named_encoding_is_trusted(self):
+        spec = {"Encoding": PSLiteral("WinAnsiEncoding")}
+        font = self._font(self.SYMBOLIC, spec)
+        assert font.to_glyphname(65) == "A"
+
+    def test_get_encoding_names_base_false(self):
+        names = EncodingDB.get_encoding_names(
+            "StandardEncoding", [7, PSLiteral("star")], base=False
+        )
+        assert names == {7: "star"}
+
+
+class TestRenderMode:
+    """`Tr` distinguishes text drawn for a reader from text drawn for a machine.
+
+    A scanner writes its OCR layer in mode 3 — no fill, no stroke, invisible —
+    on top of the page raster. Measured on a 319-page professional book scan:
+    every one of its glyphs is mode 3, while three born-digital documents and
+    one MRC-compressed scan are all mode 0. The mode is parsed by `do_Tr` and
+    was previously dropped before reaching the layout objects, so nothing
+    downstream could tell an OCR guess from typeset text.
+    """
+
+    def _chars(self, name):
+        out = []
+
+        def walk(o):
+            if isinstance(o, LTChar):
+                out.append(o)
+            elif hasattr(o, "__iter__"):
+                for c in o:
+                    walk(c)
+
+        for layout in extract_pages(absolute_sample_path(name)):
+            for e in layout:
+                walk(e)
+        return out
+
+    def test_default_is_visible_fill_mode(self):
+        """Ordinary text reports mode 0 and is not flagged invisible."""
+        chars = self._chars("simple1.pdf")
+        assert chars, "precondition: the sample yields glyphs"
+        assert all(c.render_mode == 0 for c in chars)
+        assert not any(c.invisible for c in chars)
+
+    def test_invisible_is_true_only_for_nonpainting_modes(self):
+        """Modes 3 and 7 put no marks on the page; 0-2 and 4-6 do."""
+        from pdfminer.pdfinterp import PDFGraphicState
+
+        class _Font:
+            fontname = "Test"
+            cid2name: dict = {}
+
+            def is_vertical(self):
+                return False
+
+            def get_descent(self):
+                return 0.0
+
+            def to_glyphname(self, cid):
+                return None
+
+        def make(mode):
+            return LTChar(
+                (1, 0, 0, 1, 0, 0), _Font(), 10.0, 1.0, 0.0, "x", 0.5, 0.0,
+                None, PDFGraphicState(), 1, mode,
+            )
+
+        for mode in (0, 1, 2, 4, 5, 6):
+            assert make(mode).invisible is False, mode
+        for mode in (3, 7):
+            assert make(mode).invisible is True, mode
+
+    def test_render_mode_defaults_keep_direct_construction_working(self):
+        """G1: the new parameter is optional, like `cid`."""
+        from pdfminer.pdfinterp import PDFGraphicState
+
+        class _Font:
+            fontname = "Test"
+            cid2name: dict = {}
+
+            def is_vertical(self):
+                return False
+
+            def get_descent(self):
+                return 0.0
+
+            def to_glyphname(self, cid):
+                return None
+
+        ch = LTChar(
+            (1, 0, 0, 1, 0, 0), _Font(), 10.0, 1.0, 0.0, "x", 0.5, 0.0, None,
+            PDFGraphicState(),
+        )
+        assert ch.render_mode == 0
+        assert ch.invisible is False
+        assert ch.adv == pytest.approx(5.0), "constructor must run to completion"
